API_TOKEN=ton-token-secret-ici

# Adresses d'écoute des services (le proxy s'en sert aussi pour joindre les backends)
NETWORK_ADDR=0.0.0.0:8080
ORCHESTRATOR_ADDR=127.0.0.1:8081
STORAGE_ADDR=127.0.0.1:8082
OBSERVABILITY_ADDR=127.0.0.1:9090
DASHBOARD_ADDR=127.0.0.1:3000

# Données
CONTAINERS_FILE=/var/my-cloud/containers.json
STORAGE_PATH=/tmp/my-storage

# VPN
VPN_TUN_ADDR=10.0.0.1
VPN_SEND_ADDR=0.0.0.0:9998
VPN_RECV_ADDR=0.0.0.0:9999
VPN_DEST_ADDR=127.0.0.1:9999
# 32 octets en hex (openssl rand -hex 32)
VPN_KEY=
